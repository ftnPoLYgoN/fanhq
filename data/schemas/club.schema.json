{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FanHQ Club Schema",
  "description": "Schema für Vereins-Datenblätter in FanHQ",
  "type": "object",
  "required": [
    "basisdaten",
    "offizielle_quellen",
    "inoffizielle_quellen",
    "daten_nachschlagen",
    "medien_berichterstattung",
    "stadion_matchday",
    "metadaten"
  ],
  "properties": {
    "basisdaten": {
      "type": "object",
      "required": ["id", "slug", "name", "sport", "country", "league"],
      "properties": {
        "id": { "type": "string" },
        "slug": { "type": "string" },
        "name": { "type": "string" },
        "short_name": { "type": ["string", "null"] },
        "sport": { "type": "string", "enum": ["fussball"] },
        "country": { "type": "string", "enum": ["deutschland"] },
        "league": { "type": "string" },
        "city": { "type": ["string", "null"] },
        "federal_state": { "type": ["string", "null"] },
        "stadium_name": { "type": ["string", "null"] },
        "stadium_location": { "type": ["string", "null"] },
        "stadium_capacity": { "type": ["integer", "null"] },
        "primary_colors_text": { "type": ["string", "null"] }
      }
    },
    "offizielle_quellen": { "type": "array", "items": { "$ref": "#/definitions/source" } },
    "inoffizielle_quellen": { "type": "array", "items": { "$ref": "#/definitions/source" } },
    "daten_nachschlagen": { "type": "array", "items": { "$ref": "#/definitions/source" } },
    "medien_berichterstattung": { "type": "array", "items": { "$ref": "#/definitions/source" } },
    "stadion_matchday": { "type": "array", "items": { "$ref": "#/definitions/source" } },
    "metadaten": {
      "type": "object",
      "required": ["last_checked", "confidence"],
      "properties": {
        "last_checked": { "type": "string", "format": "date-time" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "notes": { "type": ["string", "null"] },
        "missing_fields": { "type": "array", "items": { "type": "string" } },
        "update_priority": { "type": "string", "enum": ["high", "medium", "low"] }
      }
    }
  },
  "definitions": {
    "source": {
      "type": "object",
      "required": ["url", "name", "category", "source_type", "trust_level"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "name": { "type": "string" },
        "category": { 
          "type": "string", 
          "enum": ["official", "fan", "stats", "media", "stadium"] 
        },
        "source_type": { "type": "string" },
        "trust_level": { 
          "type": "string", 
          "enum": ["official", "trusted-third-party", "unofficial", "uncertain"] 
        },
        "notes": { "type": ["string", "null"] }
      }
    }
  }
}
